# FinSight AI — Environment Variables Configuration

# Base Data Directory (where vectordb, chunks, documents, embeddings live)
# Default is ./data inside backend
DATA_DIR=./data

# Hugging Face Dataset Repository (contains the pre-indexed 211MB ChromaDB & documents)
HF_DATASET_REPO=Akshaya-V/finsight_ai_dataset

# Hugging Face Access Token (required only if the dataset repository is private)
# HF_TOKEN=hf_your_personal_access_token_here

# Allowed CORS Origins (comma separated)
# In production, set to your Vercel URL: https://finsight-ai.vercel.app
CORS_ORIGINS=*

# Server Port
PORT=8000
